# Plain HTTP on port 80 inside the container. HTTPS comes from the Cloudflare
# Tunnel or whatever reverse proxy sits in front.
:80 {
	root * /srv
	encode zstd gzip

	header {
		# Revalidate on every load so a `git pull` shows up right away.
		Cache-Control "no-cache"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	file_server
}
